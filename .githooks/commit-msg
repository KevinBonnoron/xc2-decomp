#!/usr/bin/env bash
subject=$(grep -v '^#' "$1" | head -n 1)
types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
if [[ $subject =~ ^(fixup|squash|amend)!\  || $subject =~ ^Merge\  || $subject =~ ^Revert\  ]]; then
  exit 0
fi
if [[ $subject =~ ^($types)(\([a-z0-9_-]+\))?!?:\ [^[:space:]] ]]; then
  exit 0
fi
echo "commit-msg: the subject must follow Conventional Commits: type(scope): description" >&2
echo "  types: ${types//|/, }" >&2
echo "  got:   $subject" >&2
exit 1
