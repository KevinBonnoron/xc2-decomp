#!/usr/bin/env bash
set -e
run() {
  if command -v check >/dev/null; then
    "$@"
  else
    nix develop -c "$@"
  fi
}
run format --staged
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.h' 'src/*.cpp' 'include/*.h' 'include/*.cpp')
if [ ${#files[@]} -gt 0 ]; then
  run includes "${files[@]}" || {
    echo "pre-commit: run \`includes --fix\` on the staged files, then \`check\`" >&2
    exit 1
  }
fi
# The progress snapshot (README.md, progress/areas.json) is only written on main: branches and pull requests
# leave it alone, so they never conflict on it; the next commit on main refreshes it.
if [ "$(git symbolic-ref --quiet --short HEAD)" = main ]; then
  run check --readme --strict-data || {
    echo "pre-commit: \`check\` must match every function, with no compile error, nothing NOT IN GAME and no data problem outside tools/data_baseline.txt" >&2
    exit 1
  }
  run python3 tools/status.py --quiet --areas
  git add README.md progress/areas.json
else
  run check --strict-data || {
    echo "pre-commit: \`check\` must match every function, with no compile error, nothing NOT IN GAME and no data problem outside tools/data_baseline.txt" >&2
    exit 1
  }
fi
